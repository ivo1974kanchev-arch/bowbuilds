# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co          # Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                        # Supabase anon/public key (public)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                    # Supabase service role key — NEVER expose client-side

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000                           # Public base URL (update to prod domain on Vercel)

# ── Stripe ──────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key    # Stripe publishable key (public)
STRIPE_SECRET_KEY=sk_test_your-secret-key                          # Stripe secret key — server only
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret                    # Stripe webhook signing secret — server only
STRIPE_PRO_PRICE_ID=price_your-pro-price-id                        # Stripe Price ID for Pro plan ($7/mo recurring)